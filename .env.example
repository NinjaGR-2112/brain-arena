# Copier ce fichier vers `.env` (jamais committé) et renseigner les valeurs.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# L'application refuse de démarrer sans SECRET_KEY : sans elle, Starlette
# signerait les cookies de session avec la chaîne "None", connue de tous.

# Clé de signature des cookies de session. 64 caractères hexadécimaux.
SECRET_KEY=

# URL de la base. Laisser vide/commenté en local pour utiliser SQLite.
# En production (Render), pointer vers la base PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Durée de vie du cookie de session, en secondes (14 jours par défaut).
# SESSION_MAX_AGE=1209600

# Passer à `true` derrière HTTPS (Render). Laisser `false` en local.
# SESSION_COOKIE_SECURE=true
